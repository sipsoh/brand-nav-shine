{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://picxify.app/schemas/dashboard-spec.schema.json",
  "title": "Picxify Dashboard Specification",
  "description": "Portable dashboard contract generated by Picxify. The renderer should be able to render every valid spec without additional LLM calls.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "dashboard", "dataSources", "assumptions", "sections", "insights", "actions"],
  "properties": {
    "version": { "type": "string", "const": "0.1.0" },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "useCase", "audience", "theme", "generatedAt"],
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 240 },
        "useCase": {
          "type": "string",
          "enum": ["client_report", "marketing", "sales", "survey", "customer_feedback", "finance", "operations", "investor_update", "generic"]
        },
        "audience": {
          "type": "string",
          "enum": ["executive", "client", "investor", "team", "analyst", "public"]
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "tone"],
          "properties": {
            "name": { "type": "string" },
            "tone": { "type": "string", "enum": ["polished", "executive", "playful", "minimal", "agency", "analytical"] },
            "brandKitId": { "type": ["string", "null"] }
          }
        },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "dataSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datasetId", "tableId", "displayName", "rowCount", "columnCount"],
        "properties": {
          "datasetId": { "type": "string" },
          "tableId": { "type": "string" },
          "displayName": { "type": "string" },
          "rowCount": { "type": "integer", "minimum": 0 },
          "columnCount": { "type": "integer", "minimum": 0 },
          "snapshotUri": { "type": ["string", "null"] }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "layout", "widgets"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "maxLength": 100 },
          "subtitle": { "type": "string", "maxLength": 200 },
          "layout": { "type": "string", "enum": ["hero", "grid", "split", "full_width", "narrative", "appendix"] },
          "widgets": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/widget" }
          }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": { "$ref": "#/$defs/insight" }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "priority", "rationale"],
        "properties": {
          "label": { "type": "string", "maxLength": 120 },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "ownerHint": { "type": ["string", "null"] },
          "rationale": { "type": "string", "maxLength": 300 },
          "sourceInsightId": { "type": ["string", "null"] }
        }
      }
    }
  },
  "$defs": {
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "status", "confidence", "editable", "source"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["accepted", "needs_review", "rejected", "system"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "editable": { "type": "boolean" },
        "source": { "type": "string", "enum": ["profile", "semantic_mapper", "user", "template", "model"] },
        "affectedColumns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sourceTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableId", "columns", "calculation", "rowCount", "generatedBy"],
      "properties": {
        "tableId": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "filters": { "type": "array", "items": { "type": "string" } },
        "calculation": { "type": "string", "maxLength": 500 },
        "rowCount": { "type": "integer", "minimum": 0 },
        "generatedBy": { "type": "string", "enum": ["code", "model_supported_by_code", "user"] }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "sourceTrace"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": ["string", "number", "integer", "boolean"] },
        "unit": { "type": ["string", "null"] },
        "sourceTrace": { "$ref": "#/$defs/sourceTrace" }
      }
    },
    "querySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableId", "measures", "dimensions", "filters"],
      "properties": {
        "tableId": { "type": "string" },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["column", "aggregation"],
            "properties": {
              "column": { "type": "string" },
              "aggregation": { "type": "string", "enum": ["sum", "avg", "median", "min", "max", "count", "count_distinct", "rate"] },
              "alias": { "type": ["string", "null"] }
            }
          }
        },
        "dimensions": { "type": "array", "items": { "type": "string" } },
        "dateColumn": { "type": ["string", "null"] },
        "dateGrain": { "type": ["string", "null"], "enum": ["day", "week", "month", "quarter", "year", null] },
        "filters": { "type": "array", "items": { "type": "string" } },
        "sort": { "type": ["string", "null"] },
        "limit": { "type": ["integer", "null"], "minimum": 1, "maximum": 1000 }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["kpi", "chart", "insight_card", "data_table", "text", "source_panel", "assumption_panel"] },
        "title": { "type": "string", "maxLength": 100 },
        "subtitle": { "type": "string", "maxLength": 180 },
        "size": { "type": "string", "enum": ["sm", "md", "lg", "xl", "full"] },
        "kpi": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": ["string", "number"] },
            "label": { "type": "string" },
            "changeLabel": { "type": ["string", "null"] },
            "direction": { "type": ["string", "null"], "enum": ["up", "down", "flat", null] },
            "sourceTrace": { "$ref": "#/$defs/sourceTrace" }
          }
        },
        "chart": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "chartType": { "type": "string", "enum": ["line", "area", "bar", "stacked_bar", "horizontal_bar", "pie", "donut", "scatter", "heatmap", "funnel", "treemap", "word_cloud", "table"] },
            "querySpec": { "$ref": "#/$defs/querySpec" },
            "takeaway": { "type": "string", "maxLength": 240 },
            "echartsOption": { "type": "object" },
            "sourceTrace": { "$ref": "#/$defs/sourceTrace" }
          }
        },
        "insight": { "$ref": "#/$defs/insight" },
        "markdown": { "type": ["string", "null"] }
      }
    },
    "insight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "headline", "detail", "severity", "confidence", "facts", "sourceTrace"],
      "properties": {
        "id": { "type": "string" },
        "headline": { "type": "string", "maxLength": 140 },
        "detail": { "type": "string", "maxLength": 500 },
        "severity": { "type": "string", "enum": ["positive", "negative", "neutral", "warning", "opportunity"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
        "recommendedAction": { "type": ["string", "null"], "maxLength": 240 },
        "sourceTrace": { "$ref": "#/$defs/sourceTrace" }
      }
    }
  }
}
