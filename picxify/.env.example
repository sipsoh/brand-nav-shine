# Shared
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Auth: Clerk recommended for MVP org/workspace UX
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# Database
DATABASE_URL=postgresql+psycopg://picxify:picxify@localhost:5432/picxify
DATABASE_URL_NODE=postgresql://picxify:picxify@localhost:5432/picxify

# Queue/cache
REDIS_URL=redis://localhost:6379/0

# Object storage: local MinIO in dev, S3/R2/Supabase Storage in prod
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=picxify-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# AI provider
OPENAI_API_KEY=replace_me
OPENAI_MODEL_PLANNER=gpt-4.1
OPENAI_MODEL_NARRATIVE=gpt-4.1-mini
OPENAI_MODEL_TEXT_ANALYSIS=gpt-4.1-mini

# Billing
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_CREATOR_MONTHLY=price_replace_me
STRIPE_PRICE_TEAM_MONTHLY=price_replace_me

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AWS_TEXTRACT_REGION=
AWS_TEXTRACT_ROLE_ARN=

# Limits
MAX_UPLOAD_MB_FREE=10
MAX_UPLOAD_MB_CREATOR=100
MAX_ROWS_SYNC_PROFILE=100000
DEFAULT_DASHBOARD_CREDITS_FREE=3
DEFAULT_DASHBOARD_CREDITS_CREATOR=50
