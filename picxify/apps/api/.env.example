# ============================================================
# Picxify API — local development environment
#
# Setup:
#   cp .env.example .env        (run inside apps/api/)
#   then fill in the ONE required value below (Clerk JWKS URL).
#
# Everything else already matches the local docker-compose
# defaults and works as-is.
# ============================================================

APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ------------------------------------------------------------
# REQUIRED — Clerk (https://dashboard.clerk.com)
#
# In your Clerk app, open: Configure -> API Keys.
# Find "Frontend API URL" — it looks like:
#     https://your-app-name.clerk.accounts.dev
# Your JWKS URL is that URL + /.well-known/jwks.json
#
# 👇 PASTE YOURS HERE (replace the whole example value):
# ------------------------------------------------------------
CLERK_JWKS_URL=https://YOUR-APP-NAME.clerk.accounts.dev/.well-known/jwks.json

# The Clerk secret key is not used by the API yet (Milestone 2 verifies
# JWTs via JWKS only), but you can keep it here for later milestones.
CLERK_SECRET_KEY=

# ------------------------------------------------------------
# Database / queue / storage — matches docker-compose.yml, no changes needed
# ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://picxify:picxify@localhost:5432/picxify
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=picxify-dev
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------
# OPTIONAL — OpenAI (enables the LLM planner + text themes).
# Leave blank and Picxify uses its deterministic planner instead.
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_PLANNER=gpt-4.1
OPENAI_MODEL_NARRATIVE=gpt-4.1-mini
OPENAI_MODEL_TEXT_ANALYSIS=gpt-4.1-mini

# ------------------------------------------------------------
# Limits (defaults are fine for local dev)
# ------------------------------------------------------------
MAX_UPLOAD_MB_FREE=10
MAX_UPLOAD_MB_CREATOR=100
