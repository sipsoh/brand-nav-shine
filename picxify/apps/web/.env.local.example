# ============================================================
# Picxify Web — local development environment
#
# Setup:
#   cp .env.local.example .env.local     (run inside apps/web/)
#   then paste your two Clerk keys below.
#
# Get both from https://dashboard.clerk.com
#   -> your app -> Configure -> API Keys
# ============================================================

# 👇 PASTE your Publishable key (starts with pk_test_ or pk_live_):
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_PASTE_YOURS_HERE

# 👇 PASTE your Secret key (starts with sk_test_ or sk_live_):
CLERK_SECRET_KEY=sk_test_PASTE_YOURS_HERE

# Where the FastAPI backend runs — default is correct for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000
